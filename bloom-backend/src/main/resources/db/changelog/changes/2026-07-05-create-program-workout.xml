<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-07-05-create-program-workout" author="dbbon">
        <createTable tableName="program_workout">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="program_day_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_program_workout_day" references="program_day(id)"/>
            </column>
            <column name="workout_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_program_workout_workout" references="workout(id)"/>
            </column>
            <column name="sort_order" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>